# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf

# Python: 4-space indentation, line length matching ruff/pylint
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# TOML: pyproject.toml and the pipenv Pipfile
[{*.toml,Pipfile}]
indent_style = space
indent_size = 4

# YAML and JSON: 2-space indentation matching yamlfmt and pretty-format-json
[*.{json,json5,y{a,}ml}]
indent_style = space
indent_size = 2

# Markdown: a trailing double-space is a hard line break, so never trim it
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
